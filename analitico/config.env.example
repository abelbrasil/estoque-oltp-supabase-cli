# Copie para config.env (fora do Git) e preencha.

# Origem 1: banco OLTP de estoque (mesma SUPABASE_DB_URL do projeto de origem)
ESTOQUE_DB_URL=

# Arquivo do banco analítico (DuckDB), relativo a esta pasta
DW_ARQUIVO=dados/dw.duckdb

# Fuso usado para definir "o dia" de cada movimento
FUSO=America/Fortaleza

# API (opcionais)
API_HOST=127.0.0.1
API_PORTA=8000
# Origens do navegador autorizadas a chamar a API (vírgula). Só importa se o painel rodar em outro endereço.
API_ORIGENS_CORS=http://localhost:5173
